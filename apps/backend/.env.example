# Plantilla de variables del backend (dev: se carga desde apps/backend/.env).
# Tabla completa con valores por defecto: docs/12-self-hosting.md §4.
PORT=4000
# Versión que devuelve /healthz (la imagen Docker la hornea en el build).
# APP_VERSION=dev
# PHX_SERVER=true solo en releases (bin/server ya lo pone). En dev no hace falta
# (mix phx.server arranca el servidor) y rompe `mix run` con el servidor abierto
# (puerto 4000 ocupado), p. ej. al cargar priv/repo/demo_seeds.exs.
PHX_HOST=localhost

DATABASE_URL=ecto://postgres:postgres@localhost:5510/cherry_dev
DATABASE_SSL=false
POOL_SIZE=10
ECTO_IPV6=false
DB_JIT=false
# Pool y límites de espera en producción (defaults; en dev pool_size = 10).
# DB_QUEUE_TARGET_MS=50
# DB_QUEUE_INTERVAL_MS=1000
# DB_QUERY_TIMEOUT_MS=15000
# METRICS_TOKEN=                 # vacío = /metrics deshabilitado; Bearer propio

# En prod son obligatorios y no pueden ser débiles (SECRET_KEY_BASE >= 64
# caracteres, sales y MESSAGE_ENCRYPTION_KEY >= 32). Generar: mix phx.gen.secret
SECRET_KEY_BASE=
AUTH_ACCESS_TOKEN_SALT=
AUTH_REFRESH_TOKEN_SALT=

# Login: sin audiencias, todos los logins de ese proveedor se rechazan (el
# backend lo avisa al arrancar). Google: client IDs de OAuth (web para
# Android/Expo, iOS para la app iOS). Apple: APPLE_AUDIENCES más abajo.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_JWKS_CACHE_TTL_MS=600000

DNS_CLUSTER_QUERY=

# --- Dating app: photo storage (D-2026-09-29) ---
# local | r2 (s3 = alias). Dev defaults to local: files under priv/uploads
# (gitignored), uploaded via PUT /api/uploads/:token and served at /uploads.
# Required in prod.
# STORAGE_ADAPTER=local
# UPLOADS_DIR=priv/uploads
# Absolute base for photo URLs. Unset = the host of each request (LAN IP,
# localhost, tunnel...). Required in prod with STORAGE_ADAPTER=local.
# PUBLIC_BASE_URL=
# UPLOAD_MAX_BYTES=2000000
# UPLOAD_URL_TTL_SECONDS=600
#
# STORAGE_ADAPTER=r2 → Cloudflare R2, or any S3-compatible service via S3_ENDPOINT
# R2_ACCOUNT_ID=
# S3_ENDPOINT=              # e.g. http://localhost:9000 (MinIO); replaces R2_ACCOUNT_ID
# S3_REGION=                # defaults to us-east-1 with S3_ENDPOINT, auto for R2
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=cherry-photos-dev
# R2_PUBLIC_URL_BASE=
# R2_MAX_UPLOAD_BYTES=2000000
# R2_UPLOAD_URL_TTL_SECONDS=600

# --- Dating app: Expo push notifications ---
EXPO_PUSH_BASE_URL=https://exp.host
EXPO_PUSH_ACCESS_TOKEN=
EXPO_PUSH_RECEIVE_TIMEOUT_MS=5000
PUSH_CONCURRENCY=4

# --- Dating app: cifrado en reposo de mensajes (D-2026-08-21) ---
# Requerido en producción. Generar con: mix phx.gen.secret
MESSAGE_ENCRYPTION_KEY=

# --- CORS (solo clientes web: Expo Web en dev, instancias self-hosted con web) ---
# Sin definir: en dev cualquier origen; fuera de dev ninguno. Lista separada por comas, o "*".
# CORS_ALLOWED_ORIGINS=https://app.cherry.example

# --- Sign in with Apple ---
# Audiencias aceptadas (bundle ids) separadas por comas. Por defecto:
# EXPO_IOS_BUNDLE_IDENTIFIER o app.cherry.mobile.
# APPLE_AUDIENCES=app.cherry.mobile
APPLE_JWKS_CACHE_TTL_MS=600000

# --- Instancia y país (GET /api/config; una instancia de Cherry por país) ---
# Por defecto, los de la instancia española. Gestor, contacto y textos legales
# no tienen valor por defecto: cada instancia declara los suyos (TRADEMARKS.md).
# Nombre visible, p. ej. «Cherry España».
# INSTANCE_NAME=Cherry
# País (ISO 3166-1 alfa-2) e idioma por defecto (también el del flujo de Didit).
# INSTANCE_COUNTRY=ES
# INSTANCE_LOCALE=es-ES
# Quién gestiona la instancia y cómo contactar (se ve en «Acerca de»).
# INSTANCE_OPERATOR=
# INSTANCE_CONTACT_EMAIL=
# Textos legales (URLs https://…) y código del servidor que corre (AGPL-3.0).
# INSTANCE_PRIVACY_URL=
# INSTANCE_TERMS_URL=
# INSTANCE_SOURCE_URL=

# --- Verificación de edad (D-2026-10-09) ---
# Clave HMAC de la huella del documento (una persona, una cuenta), >= 32
# caracteres. Generar con: mix phx.gen.secret. NO se puede cambiar después: las
# huellas guardadas dejarían de casar. Sin ella, la verificación NFC responde
# 503 (en dev se usa un valor de relleno).
# DOCUMENT_FINGERPRINT_KEY=
# true = verificarse es obligatorio para la parte social. Desactivado por defecto.
# AGE_VERIFICATION_REQUIRED=false
# Edad mínima (18–99): la de la verificación y la de la fecha de nacimiento del perfil.
# AGE_VERIFICATION_MINIMUM_AGE=18
# Documentos aceptados: id_card (DNI, TIE y otras tarjetas de identidad) y/o passport.
# AGE_VERIFICATION_DOCUMENTS=id_card,passport
# CSCA de confianza (ficheros o carpetas separados por comas). Por defecto,
# priv/csca (CSCA españoles; ver priv/csca/README.md).
# CSCA_PATHS=
# Carpetas de país de priv/csca en las que confiar (es = España); se suman a CSCA_PATHS.
# CSCA_COUNTRIES=es
# Selfie + documento con Didit. Sin ellas, la app no ofrece ese método.
# DIDIT_API_KEY=
# DIDIT_WORKFLOW_ID=
# Aún no se usa (webhook de las sesiones «In Review»).
# DIDIT_WEBHOOK_SECRET=

# --- Solo desarrollo: datos de demo (priv/repo/demo_seeds.exs) ---
# Centro del escenario de demo, «lat,lng». Por defecto, Madrid (Puerta del Sol).
# DEMO_CENTER=40.4168,-3.7038

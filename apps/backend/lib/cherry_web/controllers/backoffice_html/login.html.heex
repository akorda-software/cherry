<.shell title="Acceso privado" flash={@flash}>
  <section class="auth" aria-labelledby="auth-title">
    <div class="auth-card">
      <div class="auth-badge"><CherryWeb.Brand.mochi size={64} /></div>
      <h1 id="auth-title">Cuidar de Cherry.</h1>
      <p class="muted">
        Acceso del equipo de atención y seguridad. Las cuentas de la app no permiten entrar aquí.
      </p>
      <p :if={@error} role="alert" class="alert alert-error">{@error}</p>
      <.form for={%{}} action={~p"/backoffice/login"} class="stack">
        <input type="hidden" name="method" value="password" />
        <div class="field">
          <label for="email">Correo del equipo</label>
          <input
            id="email"
            name="email"
            type="email"
            required
            maxlength="254"
            autocomplete="username"
          />
        </div>
        <div class="field">
          <label for="password">Contraseña</label>
          <input
            id="password"
            name="password"
            type="password"
            required
            maxlength="256"
            autocomplete="current-password"
          />
        </div>
        <button class="btn btn-primary btn-block" type="submit">Entrar con mi cuenta</button>
      </.form>
      <p class="auth-link">
        ¿Te han invitado? <a href={~p"/backoffice/invitation"}>Tengo una invitación</a>
      </p>
      <details class="recovery">
        <summary>
          <CherryWeb.Brand.icon name="key" /> Acceso de recuperación
        </summary>
        <.form for={%{}} action={~p"/backoffice/login"} class="stack">
          <div class="field">
            <label for="code">Código de un solo uso</label>
            <input
              id="code"
              name="code"
              type="password"
              required
              maxlength="128"
              autocomplete="one-time-code"
              spellcheck="false"
            />
            <p class="hint">
              Se genera desde la consola del servidor y caduca en diez minutos. Nunca lo compartas.
            </p>
          </div>
          <button class="btn btn-block" type="submit">Entrar al backoffice</button>
        </.form>
      </details>
    </div>
  </section>
</.shell>

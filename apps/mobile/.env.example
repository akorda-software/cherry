EXPO_APP_NAME=Cherry
EXPO_APP_SLUG=cherry
EXPO_APP_SCHEME=cherry
EXPO_ANDROID_PACKAGE=app.cherry.mobile
EXPO_IOS_BUNDLE_IDENTIFIER=app.cherry.mobile

EXPO_PUBLIC_API_BASE_URL_ANDROID=http://10.0.2.2:4000
EXPO_PUBLIC_API_BASE_URL_IOS=http://localhost:4000
EXPO_PUBLIC_API_BASE_URL_WEB=http://localhost:4000

EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
GOOGLE_IOS_URL_SCHEME=

EXPO_PUBLIC_MOCK_AUTH=false

# Enlace «Ver el código» de Acerca de (repositorio de tu versión; AGPL-3.0).
# Sin definir, la app no muestra el enlace.
# EXPO_PUBLIC_SOURCE_URL=https://git.example.org/tu-usuario/cherry

# Builds internas (APK release de pruebas): enseña los accesos de prueba del login
# también fuera de desarrollo. El backend solo los acepta con DEV_AUTH_MOCK=true.
# EXPO_PUBLIC_TEST_LOGIN=true

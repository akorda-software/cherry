# Variables de COMPILACIÓN de la app (se hornean en el build; cambiarlas obliga a
# recompilar). Lo que depende de la instancia (nombre, gestor, contacto, textos
# legales, edad mínima) no va aquí: la app lo pide al backend en GET /api/config.
# Tabla completa: docs/12-self-hosting.md §8.

# Identidad en las tiendas: nombre (también el de los textos de permisos),
# slug de Expo, esquema de deep links, paquete de Android y bundle ID de iOS.
EXPO_APP_NAME=Cherry
EXPO_APP_SLUG=cherry
EXPO_APP_SCHEME=cherry
EXPO_ANDROID_PACKAGE=app.cherry.mobile
EXPO_IOS_BUNDLE_IDENTIFIER=app.cherry.mobile

# URL de la API por plataforma (Android en emulador: 10.0.2.2 es el host).
EXPO_PUBLIC_API_BASE_URL_ANDROID=http://10.0.2.2:4000
EXPO_PUBLIC_API_BASE_URL_IOS=http://localhost:4000
EXPO_PUBLIC_API_BASE_URL_WEB=http://localhost:4000

# Google Sign-In: client IDs web e iOS y el «iOS URL scheme» (client ID invertido).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
GOOGLE_IOS_URL_SCHEME=

# Solo desarrollo: login y bootstrap simulados, sin backend.
EXPO_PUBLIC_MOCK_AUTH=false

# Enlace «Ver el código» de Acerca de (repositorio de tu versión; AGPL-3.0).
# Sin definir, se usa la del servidor (INSTANCE_SOURCE_URL) y, sin ninguna, no se
# muestra el enlace.
# EXPO_PUBLIC_SOURCE_URL=https://git.example.org/tu-usuario/cherry

# Builds internas (APK release de pruebas): enseña los accesos de prueba del login
# también fuera de desarrollo. El backend solo los acepta si corre en desarrollo
# (MIX_ENV=dev, `:enable_dev_test_login`).
# EXPO_PUBLIC_TEST_LOGIN=true

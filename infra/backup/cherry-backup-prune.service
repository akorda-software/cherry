[Unit]
Description=Verify Cherry seven-day backup retention and safe recovery-journal GC
After=network-online.target postgresql.service
OnFailure=cherry-backup-alert@%n.service

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/cherry-backup.py prune
RuntimeDirectory=cherry-backup-prune
RuntimeDirectoryMode=0700
UMask=0077
TimeoutStartSec=10min
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/lock

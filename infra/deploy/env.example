# Variables del servicio Cherry (se configuran en Dokploy; esto es plantilla y plan B).
# Secretos con: openssl rand -base64 48 · guardar en Bitwarden.

PORT=4000                      # 1-65535; el healthcheck de la imagen usa ${PORT:-4000}
PHX_HOST=api.cherry.example     # obligatorio: host público (URLs y redirección HTTPS)
# URL pública y HTTPS. Detrás de Cloudflare/Caddy, los valores por defecto.
# Primer despliegue solo por LAN: PHX_URL_SCHEME=http y FORCE_SSL=false.
# PHX_URL_SCHEME=https
# PHX_URL_PORT=443
# FORCE_SSL=true

# Panel opcional en otro host. Vacío conserva /backoffice en el host público.
# Con valor: /backoffice devuelve 404 en cualquier otro host; este host solo
# sirve el panel (su raíz redirige a /backoffice), no la API ni los WebSockets.
# BACKOFFICE_ENABLED=false
# BACKOFFICE_HOST=admin.cherry.example
# BACKOFFICE_TRUSTED_PROXY_IPS= # IP exacta del peer directo; nunca un rango

# Obligatorios en prod: el release no arranca si falta alguno o si es débil
# («cambiar», SECRET_KEY_BASE < 64 caracteres, el resto < 32). El error lista
# todos los que fallan a la vez. Generar cada uno con: openssl rand -base64 48
# (o mix phx.gen.secret). PHX_HOST y STORAGE_ADAPTER también son obligatorios.
SECRET_KEY_BASE=cambiar
AUTH_ACCESS_TOKEN_SALT=cambiar
AUTH_REFRESH_TOKEN_SALT=cambiar
MESSAGE_ENCRYPTION_KEY=cambiar
DATABASE_URL=ecto://cherry:PASSWORD@192.168.0.142/cherry_prod

# DB en LAN privada: sin TLS entre VMs (Caddy/Cloudflare cifran el perímetro)
DATABASE_SSL=false
POOL_SIZE=20
DB_JIT=false
DB_QUEUE_TARGET_MS=50
DB_QUEUE_INTERVAL_MS=1000
DB_QUERY_TIMEOUT_MS=15000

# Métricas Prometheus: vacío = /metrics deshabilitado; acceso con Bearer.
# Generar un secreto propio con openssl rand -base64 48.
METRICS_TOKEN=

# Push persistentes en PostgreSQL (Oban). Concurrencia por nodo, no global.
PUSH_CONCURRENCY=4
EXPO_PUSH_BASE_URL=https://exp.host
EXPO_PUSH_ACCESS_TOKEN=
EXPO_PUSH_RECEIVE_TIMEOUT_MS=5000

# strict_profile_completion no se define aquí: en prod el default es true (contrato v1)


# Clustering BEAM (futuro multi-nodo); vacío = nodo único
# DNS_CLUSTER_QUERY=

# URL pública del backend: base de las URLs absolutas de fotos. Obligatoria con
# STORAGE_ADAPTER=local (si no, se usaría la cabecera Host de cada petición).
PUBLIC_BASE_URL=https://api.cherry.example

# ── Almacenamiento de fotos (obligatorio, D-2026-09-29): local | r2 ──────
# local: fotos en disco bajo UPLOADS_DIR (volumen persistente, SIN backup de fotos),
#        subida firmada a /api/uploads/:token y servidas en /uploads.
STORAGE_ADAPTER=local
UPLOADS_DIR=/var/lib/cherry/uploads
# Límites de subida (opcionales)
# UPLOAD_MAX_BYTES=2000000
# UPLOAD_URL_TTL_SECONDS=600

# r2: Cloudflare R2 o cualquier S3 compatible. Sin configurar, upload-intent
# devuelve 503 storage_not_configured.
# STORAGE_ADAPTER=r2
# R2_ACCOUNT_ID=                # solo R2 (host <account>.r2.cloudflarestorage.com)
# S3_ENDPOINT=                  # MinIO/Garage/etc., p. ej. https://s3.lan:9000 (sustituye a R2_ACCOUNT_ID)
# S3_REGION=                    # con S3_ENDPOINT: us-east-1 por defecto (Garage: la de su config)
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# Bucket privado: desactivar r2.dev y dominios públicos. Lecturas firmadas 300 s.
# R2_PUBLIC_URL_BASE= # solo para reconocer referencias antiguas
# Jurisdicción UE: S3_ENDPOINT=https://ACCOUNT.eu.r2.cloudflarestorage.com y S3_REGION=auto
# ERASURE_JOURNAL_ENABLED=true
# ERASURE_JOURNAL_ENDPOINT=https://ACCOUNT.eu.r2.cloudflarestorage.com
# ERASURE_JOURNAL_BUCKET=cherry-recovery-journal-prod
# ERASURE_JOURNAL_ACCESS_KEY_ID=
# ERASURE_JOURNAL_SECRET_ACCESS_KEY=
# R2_MAX_UPLOAD_BYTES=2000000
# R2_UPLOAD_URL_TTL_SECONDS=600

# CORS: fuera de dev, sin definir = ningún origen web permitido (la app nativa no lo necesita).
# CORS_ALLOWED_ORIGINS=https://app.cherry.example

# ── Login (audiencias de los proveedores) ─────────────────────────────
# Sin audiencias, TODOS los logins de ese proveedor se rechazan. El backend
# arranca igualmente (una instancia puede usar solo Apple o solo Google), pero
# lo avisa en el log al arrancar.
# Google: client IDs de OAuth (Google Cloud Console → Credenciales). Web para
# Android/Expo, iOS para la app iOS. Al menos uno para permitir Google.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
# Sign in with Apple: audiencias (bundle ids) separadas por comas. Sin definir:
# EXPO_IOS_BUNDLE_IDENTIFIER o, si tampoco, app.cherry.mobile.
# APPLE_AUDIENCES=app.cherry.mobile

# ── Instancia y país (GET /api/config; tabla en docs/12-self-hosting.md) ──
# Por defecto, los de la instancia española. Gestor, contacto y textos legales
# no tienen valor por defecto: hay que declararlos (TRADEMARKS.md, condición 5).
INSTANCE_NAME=Cherry España
INSTANCE_COUNTRY=ES
INSTANCE_LOCALE=es-ES
INSTANCE_OPERATOR=
INSTANCE_CONTACT_EMAIL=
INSTANCE_PRIVACY_URL=
INSTANCE_TERMS_URL=
INSTANCE_SOURCE_URL=

# ── Verificación de edad ─────────────────────────────────────────────
# Clave HMAC de la huella del documento (>= 32 caracteres). NO se puede cambiar
# después. Guardarla con los backups, fuera de la base de datos.
DOCUMENT_FINGERPRINT_KEY=
# AGE_VERIFICATION_REQUIRED=false
# AGE_VERIFICATION_MINIMUM_AGE=18
# AGE_VERIFICATION_DOCUMENTS=id_card,passport
# CSCA_COUNTRIES=es
# CSCA_PATHS=
# DIDIT_API_KEY=
# DIDIT_WORKFLOW_ID=

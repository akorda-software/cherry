# Variables del servicio Snack (se configuran en Dokploy; esto es plantilla y plan B).
# Secretos con: openssl rand -base64 48 · guardar en Bitwarden.

PORT=4000
PHX_HOST=api.snack.example

# Obligatorios en prod (el release no arranca sin ellos)
SECRET_KEY_BASE=cambiar
AUTH_ACCESS_TOKEN_SALT=cambiar
AUTH_REFRESH_TOKEN_SALT=cambiar
MESSAGE_ENCRYPTION_KEY=cambiar
DATABASE_URL=ecto://snack:PASSWORD@192.168.0.142/snack_prod

# DB en LAN privada: sin TLS entre VMs (Caddy/Cloudflare cifran el perímetro)
DATABASE_SSL=false
POOL_SIZE=20

# strict_profile_completion no se define aquí: en prod el default es true (contrato v1)

ENABLE_SUBSCRIPTIONS=false

# Clustering BEAM (futuro multi-nodo); vacío = nodo único
# DNS_CLUSTER_QUERY=

# R2 opcional para las pruebas; sin configurar, upload-intent devuelve error controlado
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL_BASE=

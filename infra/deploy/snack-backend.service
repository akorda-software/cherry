[Unit]
Description=Snack backend (release Phoenix) — PLAN B, el principal es Dokploy (D-2026-09-04)
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
User=snack
Group=snack
WorkingDirectory=/opt/snack
Environment=HOME=/opt/snack
Environment=PHX_SERVER=true
EnvironmentFile=/opt/snack/env
ExecStart=/opt/snack/current/bin/server
Restart=always
RestartSec=5

# Muchas conexiones WebSocket
LimitNOFILE=65535

# Endurecimiento
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
